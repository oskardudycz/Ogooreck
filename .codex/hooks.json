{
  "description": "Format and compile the edited packages before an agent finishes.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/record-edit.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/validate-change.ts\"",
            "timeout": 300,
            "statusMessage": "Formatting and compiling the edited packages"
          }
        ]
      }
    ]
  }
}
