<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Deciders\BankAccountPrimitives.fs" />
        <Compile Include="Deciders\BankAccount.fs" />
        <Compile Include="Deciders\BankAccountDecider.fs" />
        <Compile Include="Deciders\BankAccountTests.fs" />
        <Compile Include="ComparisonTests.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FsCheck" Version="3.6.0" />
        <PackageReference Include="FsCheck.Xunit.v3" Version="3.6.0" />
        <PackageReference Include="FSharp.UMX" Version="1.1.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector" Version="10.1.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Update="FSharp.Core" Version="11.0.100" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Ogooreck\Ogooreck.csproj" />
    </ItemGroup>

</Project>
