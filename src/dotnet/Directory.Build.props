<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
      <Nullable>enable</Nullable>
      <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
      <ImplicitUsings>enable</ImplicitUsings>
      <RepositoryRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</RepositoryRoot>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="coverlet.msbuild" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) and '$(MSBuildProjectExtension)' == '.csproj'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/*.cs" LinkBase="Shared" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)Ogooreck/buildTransitive/Ogooreck.props"
          Condition="($(MSBuildProjectName.EndsWith('.Tests')) and '$(MSBuildProjectName)' != 'Ogooreck.Mcp.Tests') or '$(MSBuildProjectName)' == 'Ogooreck.Mcp.Fixture'" />

  <Target Name="UseRepositoryGitHooks"
          BeforeTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'Ogooreck' and '$(CI)' != 'true' and Exists('$(RepositoryRoot).git') and Exists('$(RepositoryRoot).githooks')">
    <Exec Command="git config core.hooksPath .githooks"
          WorkingDirectory="$(RepositoryRoot)"
          ContinueOnError="true"
          StandardOutputImportance="low" />
  </Target>
</Project>
