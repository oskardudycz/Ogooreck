<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <RollForward>Major</RollForward>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>ogooreck-mcp</ToolCommandName>
        <PackageType>McpServer</PackageType>
        <VersionPrefix>0.10.0</VersionPrefix>
        <Authors>Oskar Dudycz</Authors>
        <PackageProjectUrl>https://github.com/oskardudycz/Ogooreck</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/oskardudycz/Ogooreck.git</RepositoryUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <Product>Ogooreck</Product>
        <Description>MCP server that runs .NET tests and explains them to coding agents with the OpenTelemetry spans of the tests, Ogooreck and the tested app.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Google.Protobuf" Version="3.36.2" />
        <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(RepositoryRoot)README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
